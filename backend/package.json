    "backfill:device-verification:dry-run": "tsx src/scripts/backfill-device-verification.ts --dry-run",
    "backfill:device-verification": "tsx src/scripts/backfill-device-verification.ts --apply"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
